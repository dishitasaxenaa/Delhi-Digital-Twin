# Delhi Digital Twin - Backend Environment Configuration

# -------------------------------------------------------------
# Database Configuration
# -------------------------------------------------------------
# PostgreSQL is required. No SQLite fallback is supported.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/delhi_digital_twin

# -------------------------------------------------------------
# Traffic API Configuration (TomTom)
# -------------------------------------------------------------
# Get your free key at: https://developer.tomtom.com/
# Free tier provides 2,500 free queries/day
TOMTOM_API_KEY=

# Congestion Thresholds (Ratio of currentSpeed / freeFlowSpeed)
# Above 80% (0.80) -> Low
# 60% - 80% (0.60) -> Moderate
# 40% - 60% (0.40) -> High
# Below 40%        -> Severe
TRAFFIC_LOW_THRESHOLD=0.80
TRAFFIC_MODERATE_THRESHOLD=0.60
TRAFFIC_HIGH_THRESHOLD=0.40

# -------------------------------------------------------------
# Air Quality API Configuration
# -------------------------------------------------------------
# OpenAQ API Key (v3): https://docs.openaq.org/
OPENAQ_API_KEY=

# Data.gov.in API Key (CPCB Real-time CAAQMS): https://data.gov.in/
DATA_GOV_IN_API_KEY=

# WAQI (World Air Quality Index / aqicn.org) Token: https://aqicn.org/data-platform/token/
WAQI_API_TOKEN=

# -------------------------------------------------------------
# Cache & Refresh Settings (in seconds)
# -------------------------------------------------------------
TRAFFIC_CACHE_TTL=120     # 2 minutes (avoids exceeding API rate limits)
AQI_CACHE_TTL=900         # 15 minutes (matches CPCB / sensor refresh cycles)
HOST=0.0.0.0
PORT=8000
